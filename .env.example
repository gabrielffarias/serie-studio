# Banco (Postgres externo; o docker-compose.yml é opcional, para outras máquinas)
DATABASE_URL=postgresql://usuario:senha@192.168.0.2:5432/serie_studio

# Publicação (Fase 4)
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=
PUBLIC_BASE_URL=

# Render
HYPERFRAMES_NO_TELEMETRY=1
RENDER_WORKERS=2

# Voz (Fase 2)
TTS_PROVIDER=edge-tts
TTS_VOICE_NARRADOR=pt-BR-AntonioNeural
VOICESTUDIO_URL=

# Claude CLI
CLAUDE_PATH=claude
CLAUDE_SCRIPT_TIMEOUT_MS=720000
CLAUDE_COPY_TIMEOUT_MS=480000
